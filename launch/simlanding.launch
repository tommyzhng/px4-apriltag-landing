<launch>
    <node pkg="px4_apriltag_landing" type="px4_apriltag_landing_node" name="px4_apriltag_landing_node" output="screen"/>
    <rosparam command="load" file="$(find px4_apriltag_landing)/config/params.json"/>
    <include file="$(find apriltag_ros)/launch/continuous_detection.launch">
        <arg name="camera_name" value="/iris/usb_cam"/>
        <arg name="image_topic" default="image_raw" />
    </include>
</launch>
